<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NumberSystemConverter.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NumberSystemConverter.Views.MainView"
             x:DataType="vm:MainViewModel"
             FontSize="18">
    
    <ScrollViewer>
        <StackPanel Spacing="8"
                    VerticalAlignment="Top"
                    Margin="32">
        
            <ComboBox Name="NumberSystemComboBox1" HorizontalAlignment="Stretch"></ComboBox>
            <TextBox Name="InputBox" TextInputOptions.ContentType="Digits"></TextBox>
        
            <Separator></Separator>
        
            <ComboBox Name="NumberSystemComboBox2" HorizontalAlignment="Stretch"></ComboBox>
            <TextBox Name="OutputBox" IsReadOnly="True"></TextBox>
        
            <TextBlock Text="Použitá metoda: Postupné Odečítání" HorizontalAlignment="Center" Margin="16" FontSize="12"></TextBlock>
        
            <TextBlock Name="LokaceText" HorizontalAlignment="Left" Margin="16" FontSize="12"></TextBlock>
            <TextBlock Name="StepsText" HorizontalAlignment="Left" Margin="16" FontSize="12"></TextBlock>
        </StackPanel>
    </ScrollViewer>

</UserControl>
