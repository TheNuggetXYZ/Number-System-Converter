<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NumberSystemConverter.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NumberSystemConverter.Views.MainView"
             x:DataType="vm:MainViewModel"
             FontSize="18">
    
    <Grid RowDefinitions="Auto, Auto, *, Auto, Auto"
          RowSpacing="8"
          VerticalAlignment="Top"
          Margin="32">
        
        <ComboBox Name="NumberSystemComboBox1" Grid.Row="0" HorizontalAlignment="Stretch"></ComboBox>
        <TextBox Grid.Row="1"></TextBox>
        
        <Separator Grid.Row="2"></Separator>
        
        <ComboBox Name="NumberSystemComboBox2" Grid.Row="3" HorizontalAlignment="Stretch"></ComboBox>
        <TextBox Grid.Row="4"></TextBox>
    </Grid>

</UserControl>
